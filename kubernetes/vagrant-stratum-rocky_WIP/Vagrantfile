# -*- mode: ruby -*-
# vi: set ft=ruby :

Vagrant.configure("2") do |config|

  $pass = ENV["pass"] || "vagrant"

  $common_script = <<-SCRIPT
    echo "vagrant:#{$pass}" | chpasswd

    mv /home/vagrant/init.sh /root/
    sed -i 's;vmuser=.*;vmuser="vagrant";g' /root/init.sh

    # to use a pre-downloaded stratum binary
    mv /home/vagrant/stratum-linux-amd64 /root/

    /root/init.sh
  SCRIPT

  config.vm.define "k8s" do |mach|
    mach.vm.box = "rockylinux/9"
    mach.vm.box_version = "6.0.0"
    mach.vm.box_check_update = false
    mach.vm.synced_folder ".", "/vagrant", disabled: true

    mach.vm.provider "libvirt" do |libvirt|
      libvirt.memory = 8192
      libvirt.cpus = 2
      libvirt.machine_virtual_size = 20
    end

    # specific to stratum
    mach.vm.network "forwarded_port", guest: 8443, host: 8443, auto_correct: true
    mach.vm.network "forwarded_port", guest: 30443, host: 30443, auto_correct: true

    mach.vm.provision "file", source: "init.sh", destination: "/home/vagrant/init.sh"
    # to use a pre-downloaded stratum binary
    mach.vm.provision "file", source: "stratum-linux-amd64", destination: "/home/vagrant/stratum-linux-amd64"
    mach.vm.provision "shell", inline: $common_script
  end

end
