# -*- mode: ruby -*-
# vi: set ft=ruby :

Vagrant.configure("2") do |config|

  $pass = ENV["pass"] || "vagrant"

  $common_script = <<-SCRIPT
    chsh -s /bin/bash vagrant
    echo "vagrant:#{$pass}" | chpasswd

    mv /home/vagrant/init-prereq.sh /root/
    sed -i 's;vmuser=.*;vmuser="vagrant";g' /root/init-prereq.sh
    sed -i 's;vmuser=.*;vmuser="vagrant";g' /home/vagrant/init-slinky-bridge.sh
    mv /home/vagrant/post-prereq.sh /root/
    sed -i 's;vmuser=.*;vmuser="vagrant";g' /root/post-prereq.sh

    /root/init-prereq.sh
    sudo -u vagrant /home/vagrant/init-slinky-bridge.sh
    /root/post-prereq.sh
  SCRIPT

  config.vm.define "slinky" do |mach|
    mach.vm.box = "cloud-image/ubuntu-24.04"
    mach.vm.box_version = "20251126.0.0"
    mach.vm.box_check_update = false
    #mach.vm.synced_folder ".", "/vagrant", type: "nfs", nfs_udp: false, disabled: false

    mach.vm.provider "libvirt" do |libvirt|
      libvirt.memory = 4096
      libvirt.cpus = 4
      libvirt.machine_virtual_size = 160
    end

    mach.vm.provision "file", source: "init-prereq.sh", destination: "/home/vagrant/init-prereq.sh"
    mach.vm.provision "file", source: "init-slinky-bridge.sh", destination: "/home/vagrant/init-slinky-bridge.sh"
    mach.vm.provision "file", source: "post-prereq.sh", destination: "/home/vagrant/post-prereq.sh"
    mach.vm.provision "shell", inline: $common_script
  end

end
